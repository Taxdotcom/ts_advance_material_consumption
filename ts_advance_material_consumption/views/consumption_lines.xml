<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_consumption_lines" model="ir.ui.view">
        <field name="name">view.consumption.lines</field>
        <field name="model">stock.consumption.lines</field>
        <field name="arch" type="xml">
            <tree default_order="location_id, product_id" editable="bottom" create="1" edit="1">
                <field name="company_id" column_invisible="True"/>
                <field name="state" column_invisible="True"/>
                <field name="consumption_qty_set" column_invisible="True"/>
                <header>
                    <button name="action_apply_consumption" groups="stock.group_stock_manager" type="object"
                            string="Apply"/>
                </header>
                <field name="consumption_id" column_invisible="True"/>
                <field name="location_id" domain="[('usage', 'in', ['internal', 'transit'])]"
                       readonly="id != False" column_invisible="context.get('hide_location', False)"
                       options="{'no_create': True}"/>
<!--                readonly="id != False"-->
                <field name="product_id"
                       readonly="context.get('single_product', False) and id != False" force_save="1" options="{'no_create': True}"/>
                <field name="quantity" optional="show" string="On Hand Quantity"/>
                <field name="inventory_quantity" widget="counted_quantity_widget" column_invisible="True"/>
                <field name="consume_qty" readonly="state == 'done'"/>
            </tree>
        </field>
    </record>
</odoo>